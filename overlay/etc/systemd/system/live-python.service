[Unit]
Description=Run the live Python application on tty1
After=systemd-user-sessions.service local-fs.target systemd-udev-settle.service network-online.target systemd-timesyncd.service
Wants=local-fs.target systemd-udev-settle.service network-online.target systemd-timesyncd.service
Conflicts=getty@tty1.service

[Service]
Type=simple
WorkingDirectory=/opt/live-app
ExecStart=/usr/local/bin/run-live-app
Restart=always
RestartSec=1
StandardInput=tty
StandardOutput=tty
StandardError=tty
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes

[Install]
WantedBy=multi-user.target

